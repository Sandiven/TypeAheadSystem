# Copy this file to .env (or just export these in your shell) and adjust
# if your local Postgres differs from the docker-compose defaults.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=typeahead
DB_USER=postgres
DB_PASSWORD=postgres
MAX_DFS_NODES=20000

# Phase 3: distributed cache (consistent hashing). Defaults below match
# the measured/justified values in docs/vnode_sensitivity_results.md and
# the project README -- override only if you're re-running the
# sensitivity study with different parameters.
CACHE_NODE_COUNT=3
CACHE_VIRTUAL_NODES=150
CACHE_TTL_SECONDS=45

# Phase 4: trending / recency-aware ranking.
# Set RECENCY_WINDOW_MINUTES=1 during a viva demo to see window expiry
# in real time instead of waiting 60 minutes.
RECENCY_WINDOW_MINUTES=60
RECENCY_WEIGHT=3

# Phase 5: Batch writer
BATCH_FLUSH_INTERVAL=5.0
BATCH_MAX_BUFFER_SIZE=100
